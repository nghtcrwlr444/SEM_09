def merge(a, b):
    c = []

    while len(a) > 0 and len(b) > 0:
        if a[0] > b[0]:
            c.append(b.pop(0))
        else:
            c.append(a.pop(0))

    while len(a) > 0:
        c.append(a.pop(0))

    while len(b) > 0:
        c.append(b.pop(0))

    return c

def mergesort(a):
    if len(a) <= 1:
        return a

    medio = len(a) // 2
    arrayOne = a[:medio]
    arrayTwo = a[medio:]

    arrayOne = mergesort(arrayOne)
    arrayTwo = mergesort(arrayTwo)

    return merge(arrayOne, arrayTwo)


def main():
    entrada = input("Por favor ingrese los números separados por espacio: ")
    numeros = [int(x) for x in entrada.split()]

    resultado = mergesort(numeros)
    print("Arreglo ordenado seria:", resultado)

main()